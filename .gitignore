# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Runtime data (regenerated on demand)
data/cache/

# Local team notes / logs / scratch
.local/
*.log
*.output

# Secrets — real values live ONLY in an untracked .env on the host.
